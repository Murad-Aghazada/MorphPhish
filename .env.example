# Copy to .env and adjust for your environment: cp .env.example .env
APP_NAME=MorphPhish
APP_ENV=development
# Generate a real secret for non-dev environments (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`)
APP_SECRET_KEY=change-me-in-real-environments
DATABASE_URL=postgresql+psycopg://riskintern:riskintern@db:5432/riskintern_phishsim
POSTGRES_DB=riskintern_phishsim
POSTGRES_USER=riskintern
POSTGRES_PASSWORD=riskintern
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Providers default to safe, offline mock mode.
# LLM: mock (offline) / openai (GPT) / anthropic (Claude) / gemini (Google AI Studio) — set LLM_MODEL to match
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_MAX_TOKENS=900

HR_PROVIDER=mock
HR_API_URL=
HR_API_KEY=

CAMPAIGN_PROVIDER=mock
GOPHISH_URL=https://gophish.example.invalid:3333
GOPHISH_API_KEY=
GOPHISH_VERIFY_TLS=true

EMAIL_PROVIDER=mock
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=simulation@demo.example.com
# Only recipients in these domains may be emailed by the SMTP provider.
AUTHORIZED_EMAIL_DOMAINS=demo.example.com,example.com

SEED_ON_START=true
LOG_LEVEL=INFO
