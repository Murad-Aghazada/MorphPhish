# Copy to .env and adjust for your environment: cp .env.example .env
APP_NAME=MorphPhish
# development = lab defaults allowed. production = the backend REFUSES to start
# while ADMIN_PASSWORD / APP_SECRET_KEY are still the defaults below.
APP_ENV=development
# Signs admin session tokens — MUST be changed for production.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-in-real-environments
# Admin console sign-in (demo: root / root). Change ADMIN_PASSWORD for production.
ADMIN_USERNAME=root
ADMIN_PASSWORD=root
# Admin session + brute-force protection.
TOKEN_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Honour X-Forwarded-For for the login throttle. Set true ONLY when the backend is
# reached exclusively through the bundled reverse proxy; leave false if the backend
# port is directly reachable (the header would be client-spoofable).
TRUST_PROXY_HEADERS=false
DATABASE_URL=postgresql+psycopg://riskintern:riskintern@db:5432/riskintern_phishsim
POSTGRES_DB=riskintern_phishsim
POSTGRES_USER=riskintern
POSTGRES_PASSWORD=riskintern
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Providers default to safe, offline mock mode.
# LLM: mock (offline) / openai / anthropic (Claude) / gemini (Google AI Studio) / nvidia (NVIDIA NIM) — set LLM_MODEL to match
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MAX_TOKENS=900

HR_PROVIDER=mock
HR_API_URL=
HR_API_KEY=

CAMPAIGN_PROVIDER=mock
# To use the bundled GoPhish engine: set CAMPAIGN_PROVIDER=gophish, paste the API
# key (GoPhish UI - Account Settings) below, then restart the backend container.
GOPHISH_URL=http://gophish:3333
GOPHISH_PHISH_URL=http://localhost:8080
GOPHISH_API_KEY=
GOPHISH_VERIFY_TLS=false

# mock = no external delivery (default). smtp = deliver to the bundled Mailpit
# test inbox at http://localhost:8025 (local stand-in for Mailtrap).
EMAIL_PROVIDER=mock
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=simulation@demo.example.com
# Only recipients in these domains may be emailed by the SMTP provider.
AUTHORIZED_EMAIL_DOMAINS=demo.example.com,example.com
# The Mailpit inbox is served through the app at http://localhost:3000/mailpit/ and
# is gated by the admin session (sign in first) — no separate Mailpit login needed.

SEED_ON_START=true
LOG_LEVEL=INFO
